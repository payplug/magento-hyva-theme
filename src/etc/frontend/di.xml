<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Hyva\CompatModuleFallback\Model\CompatModuleRegistry">
        <arguments>
            <argument name="compatModules" xsi:type="array">
                <item name="hyva-magento2-payplug-theme" xsi:type="array">
                    <item name="original_module" xsi:type="string">Payplug_Payments</item>
                    <item name="compat_module" xsi:type="string">Payplug_PaymentsHyvaTheme</item>
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Payplug\PaymentsHyvaTheme\ViewModel\PayplugThemeIcons">
        <arguments>
            <argument name="iconPathPrefix" xsi:type="string">Payplug_PaymentsHyvaTheme::svg/payplug</argument>
        </arguments>
    </type>
</config>
