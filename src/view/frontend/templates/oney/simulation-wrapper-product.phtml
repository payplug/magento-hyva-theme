declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductPrice;
use Magento\Catalog\Block\Product\View;
use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Framework\Escaper;

/**
 * @var View $block
 * @var Escaper $escaper
 * @var ViewModelRegistry $viewModels
 * @var ProductPrice $productPriceViewModel
 */
$simulationBlock = $block->getChildBlock('payplug-payments-product-oney-simulation');

if (!$simulationBlock) {
    return;
}

$product = $block->getProduct();
$productPriceViewModel = $viewModels->require(ProductPrice::class);
$simulationHtml = $simulationBlock
    ->setData('amount', $productPriceViewModel->getPriceValue(FinalPrice::PRICE_CODE, $product))
    ->setData('product_id', (int) $product->getId())
    ->toHtml();

if (trim($simulationHtml) === '') {
    return;
}
?>
<div class="oney-wrapper oney-product <?= $escaper->escapeHtmlAttr($block->getContainerCssClasses()); ?>">
    <?= /* @noEscape */ $simulationHtml; ?>
</div>
